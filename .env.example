# UC30 Challenge - Environment Variables
# Copy this file to .env and fill in your Supabase credentials
#
# To get these values:
# 1. Go to supabase.com and create a free account
# 2. Create a new project
# 3. Go to Settings > API
# 4. Copy the URL and anon/public key below

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Payment Link (optional)
# Create a Payment Link at https://dashboard.stripe.com/payment-links
# Set the success URL to: https://your-domain.com/?paid=true
# If not set, users can register without payment
VITE_STRIPE_PAYMENT_LINK=
