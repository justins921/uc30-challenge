# UC30 Challenge - Environment Variables
# Copy this file to .env and fill in your Supabase credentials
#
# To get these values:
# 1. Go to supabase.com and create a free account
# 2. Create a new project
# 3. Go to Settings > API
# 4. Copy the URL and anon/public key below

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Connect Checkout (optional — replaces VITE_STRIPE_PAYMENT_LINK)
# Base URL for Supabase Edge Functions (e.g. https://<project-ref>.supabase.co/functions/v1)
# If not set, CTA buttons fall back to direct registration
VITE_SUPABASE_FUNCTION_URL=

# The following secrets are set as Supabase Edge Function secrets (not Vercel env vars):
# STRIPE_SECRET_KEY          — Sobojinski Solutions platform Stripe secret key
# STRIPE_WEBHOOK_SECRET      — from Stripe webhook dashboard
# STRIPE_CONNECTED_ACCOUNT_ID — Chandler's Stripe acct_ ID
# RESEND_API_KEY             — from resend.com > API Keys (used by send-email + stripe-webhook)
# RESEND_FROM_EMAIL          — e.g. "UC30 <noreply@uc30.com>" (requires verified domain in Resend)

# Kit (ConvertKit) - Email Marketing (optional)
# 1. Log in to kit.com
# 2. Go to Grow > Landing Pages & Forms > Create a form (or use existing)
# 3. Copy the form ID from the URL (e.g., kit.com/forms/designers/FORM_ID)
# 4. Go to Settings > Developer > API key
# 5. Add both values below
VITE_KIT_API_KEY=
VITE_KIT_FORM_ID=

# Tolt Affiliate Tracking
# Chandler's Tolt account — tracks affiliate referrals with 15% commission
# The public ID is hardcoded in index.html (data-tolt attribute)
# Tolt connects to Stripe via OAuth in the Tolt dashboard — no env vars needed here
# To set up: Log in to tolt.io > Settings > Integrations > Connect Stripe
